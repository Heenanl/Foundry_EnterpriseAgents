# The Azure Bot registration (this bot's own channel identity).
# MINIMAL INFRA: use ONE app as bot identity + Teams SSO target + OBO client. MicrosoftAppId here ==
# the hosted agent's APP_OBO_CLIENT_ID == the teams-sso connection's client id. One secret serves both
# the Bot channel (MicrosoftAppPassword) and the OBO exchange.
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=

# Bot Service OAuth Connection Setting that performs Teams SSO. Its AAD app is the SSO/OBO app
# configured by scripts/Configure-TeamsSso-App.ps1 (api://botid-<appId>, access_as_user, Teams preauth).
OAUTH_CONNECTION_NAME=teams-sso

# The deployed per-user hosted agent this bot fronts.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Default agent (used until the user switches). ONE bot fronts many agents.
AGENT_NAME=agent-framework-agent-sharepoint-copilot-retrieval
# Optional: other agents this same bot can route to (comma-separated). Users switch with "/use <name>".
AGENTS=
FOUNDRY_API_VERSION=2025-11-15-preview
FOUNDRY_SCOPE=https://ai.azure.com/.default

PORT=3978
